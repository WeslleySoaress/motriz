# ─────────────────────────────────────────────────────────────────────────────
# Motriz — exemplo de variáveis de ambiente
# Copie para `.env` e ajuste. NUNCA versione o arquivo `.env`.
# Nenhum valor abaixo é uma credencial real.
# ─────────────────────────────────────────────────────────────────────────────

# Banco de dados (SQLite por padrão; para PostgreSQL troque o provider no
# schema.prisma e use postgresql://usuario:senha@host:5432/motriz?schema=public)
DATABASE_URL="file:./prisma/dev.db"

# URL pública da aplicação. Usada em links de e-mail, canonical e CSRF/Origin.
APP_URL="http://localhost:3000"

# Segredo do servidor. Usado para derivar o identificador anônimo da contagem
# de visualizações. Trate como credencial: nunca versione o .env.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-por-32-bytes-aleatorios-em-hexadecimal"

# Diretório de armazenamento dos uploads (relativo à raiz do projeto).
STORAGE_DIR="storage/uploads"

# Limites de upload
UPLOAD_MAX_FILE_MB="8"
UPLOAD_MAX_FILES_PER_LISTING="12"

# Envio de e-mail.
# "console" = grava a mensagem em log/e-mails (padrão de desenvolvimento).
# "smtp"    = NÃO IMPLEMENTADO nesta entrega; ver docs/PENDENCIAS.md.
MAIL_TRANSPORT="console"
MAIL_FROM="Motriz <nao-responda@motriz.local>"

# Moderação: quando "true", anúncios novos entram como PENDING e só ficam
# públicos após aprovação do admin. Quando "false", vão direto para PUBLISHED.
MODERATION_ENABLED="true"

# Conta administradora criada pelo seed (apenas ambiente de desenvolvimento).
SEED_ADMIN_EMAIL="admin@motriz.local"
SEED_ADMIN_PASSWORD="Motriz!Admin2024"
SEED_DEMO_PASSWORD="Motriz!Demo2024"
